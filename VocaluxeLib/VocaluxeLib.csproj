<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>VocaluxeLib</RootNamespace>
    <AssemblyName>VocaluxeLib</AssemblyName>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.TextWriter" Version="3.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Log\CLogFunctions.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>CLogFunctions.tt</DependentUpon>
    </Compile>
    <None Update="Log\CLogFunctions.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>CLogFunctions.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>
