<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>VocaluxeLib.PartyModes.TicTacToe</RootNamespace>
    <AssemblyName>TicTacToe</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <OutputPath>bin</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\VocaluxeLib\VocaluxeLib.csproj">
      <Private>False</Private>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyPartyModeSources" AfterTargets="Build">
    <ItemGroup>
      <PartyModeSources Include="*.cs" Exclude="GlobalSuppressions.cs" />
    </ItemGroup>
    <RemoveDir Directories="$(MSBuildThisFileDirectory)..\..\Output\PartyModes\$(TargetName)\Code" />
    <Copy SourceFiles="@(PartyModeSources)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\Output\PartyModes\$(TargetName)\Code" />
  </Target>
</Project>
