<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Tests</RootNamespace>
    <AssemblyName>Tests</AssemblyName>
    <Platforms>x86;x64</Platforms>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" PrivateAssets="all" />
    <PackageReference Include="NunitXml.TestLogger" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="VocaluxeLib\Log\CLogTest.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>CLogTest.tt</DependentUpon>
    </Compile>
    <None Update="VocaluxeLib\Log\CLogTest.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>CLogTest.cs</LastGenOutput>
    </None>
    <Content Include="VocaluxeLib\XML\TestFiles\*.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PartyModes\PartyModeChallenge\PartyModeChallenge.csproj" />
    <ProjectReference Include="..\VocaluxeLib\VocaluxeLib.csproj" />
    <ProjectReference Include="..\Vocaluxe\Vocaluxe.csproj" />
  </ItemGroup>
</Project>
