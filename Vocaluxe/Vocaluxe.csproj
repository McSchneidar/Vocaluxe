<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Vocaluxe</RootNamespace>
    <AssemblyName>Vocaluxe</AssemblyName>
    <StartupObject>Vocaluxe.CMainProgram</StartupObject>
    <ApplicationIcon>Vocaluxe.ico</ApplicationIcon>
    <Platforms>x86;x64</Platforms>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <OutputPath>..\Output\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Platform)' == 'x86' ">
    <DefineConstants>$(DefineConstants);ARCH_X86</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Platform)' == 'x64' ">
    <DefineConstants>$(DefineConstants);ARCH_X64</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenTK.Graphics" Version="4.9.4" />
    <PackageReference Include="OpenTK.Audio.OpenAL" Version="4.9.4" />
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="org.k2fsa.portaudio.runtime.win-x64" Version="1.0.6" Condition=" '$(Platform)' == 'x64' " />
    <PackageDownload Include="vocaluxe.dependencies.portaudiosharp" Version="[1.0.3]" />
    <PackageReference Include="FlashCap" Version="1.12.0" />
    <PackageReference Include="vocaluxe.dependencies.acinerella" Version="1.0.6" Condition=" '$(IsWindowsConfig)' == 'true' " />
    <PackageReference Include="vocaluxe.dependencies.ffmpeg" Version="1.0.6" Condition=" '$(IsWindowsConfig)' == 'true' " />
    <PackageReference Include="vocaluxe.dependencies.hidapi" Version="1.0.4" Condition=" '$(IsWindowsConfig)' == 'true' " />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" Condition=" '$(IsWindowsConfig)' == 'true' " />
    <PackageReference Include="Vortice.XInput" Version="3.8.3" />
    <PackageReference Include="NAudio.Wasapi" Version="22.0.0" Condition=" '$(IsWindowsConfig)' == 'true' " />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VocaluxeLib\VocaluxeLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Animations\**" />
    <Compile Remove="Base\Font\CGlyph.cs" />
    <Compile Remove="Lib\Draw\CDirect3D.cs" Condition=" '$(IsWindowsConfig)' != 'true' " />
    <Compile Remove="Lib\Sound\Record\NAudio\CNAudioRecord.cs" Condition=" '$(IsWindowsConfig)' != 'true' " />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Reporting\Reporter.resx">
      <DependentUpon>Reporter.cs</DependentUpon>
    </EmbeddedResource>
    <None Include="Doc\**" />
    <Content Include="Website\locales\cs.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\de.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\en.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\es.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\fr.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\it.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\nl.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\pt.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\sv.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\locales\tr.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\images\ajax-loader.gif" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\images\alert.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\images\icons-18-black.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\images\icons-18-white.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\images\icons-36-black.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\images\icons-36-white.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\jquery.mobile-1.3.2.min.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\jquery.mobile.theme-1.3.2.min.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\css\style.css" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\addPlaylist.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\logout.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\music.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\noCover.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\playlist.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\playlists.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\spotify.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\wikipedia.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\youtube.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\admin.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\keyboard.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\photo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\profile.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\img\profiles.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\js\i18next-1.7.1.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\js\jquery-1.9.1.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\js\jquery-ui-1.10.3.custom.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\js\jquery.mobile-1.3.2.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\js\jquery.ui.touch-punch.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Website\js\main.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VocaluxePreBuild" BeforeTargets="BeforeBuild">
    <Exec Condition=" '$(OS)' == 'Windows_NT' " Command="powershell -ExecutionPolicy Bypass -Command &quot;&amp; '$(MSBuildThisFileDirectory)..\.build\winPreBuild.ps1' -ProjectDir '$(MSBuildThisFileDirectory)' -Arch '$(Platform)'&quot;" />
    <Exec Condition=" '$(OS)' != 'Windows_NT' And '$(IsWindowsConfig)' != 'true' " Command="&quot;$(MSBuildThisFileDirectory)../.build/linuxPreBuildEvent.sh&quot; &quot;$(MSBuildThisFileDirectory)&quot; $(Platform)" />
  </Target>

  <Target Name="CopyPortAudioX86" AfterTargets="Build" Condition=" '$(Platform)' == 'x86' ">
    <Copy SourceFiles="$(NuGetPackageRoot)vocaluxe.dependencies.portaudiosharp\1.0.3\x86\portaudio.dll" DestinationFolder="$(TargetDir)" />
  </Target>

  <Target Name="VocaluxePostBuild" AfterTargets="Build">
    <ItemGroup>
      <WebsiteFiles Include="$(MSBuildThisFileDirectory)Website\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebsiteFiles)" DestinationFiles="@(WebsiteFiles->'$(MSBuildThisFileDirectory)..\PhoneGap\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Exec Condition=" '$(OS)' == 'Windows_NT' " Command="powershell -ExecutionPolicy Bypass -Command &quot;&amp; '$(MSBuildThisFileDirectory)..\.build\winPostBuild.ps1' -ProjectDir '$(MSBuildThisFileDirectory)'&quot;" />
    <Exec Condition=" '$(OS)' != 'Windows_NT' And '$(IsWindowsConfig)' != 'true' " Command="&quot;$(MSBuildThisFileDirectory)../.build/linuxPostBuildEvent.sh&quot; &quot;$(MSBuildThisFileDirectory)&quot;" />
  </Target>
</Project>
