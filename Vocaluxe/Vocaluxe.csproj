<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Vocaluxe</RootNamespace>
    <AssemblyName>Vocaluxe</AssemblyName>
    <StartupObject>Vocaluxe.CMainProgram</StartupObject>
    <ApplicationIcon>Vocaluxe.ico</ApplicationIcon>
    <Platforms>x86;x64</Platforms>
    <OutputPath>..\Output\</OutputPath>
    <SelfContained>false</SelfContained>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <RuntimeIdentifiers>win-x86;win-x64;linux-x64</RuntimeIdentifiers>
    <IsWindowsConfig>$(Configuration.EndsWith('Win'))</IsWindowsConfig>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindowsConfig)' == 'true'">
    <RuntimeIdentifier Condition="'$(Platform)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsWindowsConfig)' != 'true' And '$(Platform)' == 'x64'">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Animations\**" />
    <Compile Remove="Base\Font\**" />
    <None Remove="Animations\**;Base\Font\**" />
    <Compile Remove="Lib\Draw\CDirect3D.cs;Lib\Sound\Record\NAudio\CNAudioRecord.cs" Condition="'$(IsWindowsConfig)' != 'true'" />
    <Compile Remove="Base\Web\CVocaluxeRemote.cs" Condition="'$(IsWindowsConfig)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="vocaluxe.dependencies.aforgevideo" Version="1.0.1" />
    <PackageReference Include="vocaluxe.dependencies.csharpsqlite" Version="1.0.1" />
    <PackageReference Include="vocaluxe.dependencies.gstreamersharp" Version="1.0.1" />
    <PackageReference Include="vocaluxe.dependencies.opentk" Version="1.0.1" />
    <PackageReference Include="vocaluxe.dependencies.portaudiosharp" Version="1.0.3" />
    <PackageReference Include="vocaluxe.dependencies.qrcoder" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsWindowsConfig)' == 'true'">
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Vortice.Direct3D9" Version="2.4.2" />
    <PackageReference Include="vocaluxe.dependencies.acinerella" Version="1.0.6" />
    <PackageReference Include="vocaluxe.dependencies.ffmpeg" Version="1.0.6" />
    <PackageReference Include="vocaluxe.dependencies.hidapi" Version="1.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VocaluxeLib\VocaluxeLib.csproj" />
    <ProjectReference Include="..\VocaluxeWeb\VocaluxeWeb.csproj" Condition="'$(IsWindowsConfig)' == 'true'" />
  </ItemGroup>

  <PropertyGroup>
    <PreBuildEvent Condition=" '$(OS)' == 'Windows_NT' ">powershell -ExecutionPolicy Bypass -Command "&amp; '$(MSBuildProjectDirectory)\..\.build\winPreBuild.ps1' -ProjectDir '$(ProjectDir)' -Arch '$(Platform)'"</PreBuildEvent>
    <PreBuildEvent Condition=" '$(OS)' != 'Windows_NT' ">$(MSBuildProjectDirectory)/../.build/linuxPreBuildEvent.sh $(ProjectDir) $(Platform)</PreBuildEvent>
    <PostBuildEvent Condition=" '$(OS)' == 'Windows_NT' ">powershell -ExecutionPolicy Bypass -Command "&amp; '$(MSBuildProjectDirectory)\..\.build\winPostBuild.ps1' -ProjectDir '$(ProjectDir)'"</PostBuildEvent>
    <PostBuildEvent Condition=" '$(OS)' != 'Windows_NT' ">$(MSBuildProjectDirectory)/../.build/linuxPostBuildEvent.sh $(ProjectDir)</PostBuildEvent>
  </PropertyGroup>

  <Target Name="gstreamerBeforeBuild" BeforeTargets="BeforeBuild" Condition="'$(IsWindowsConfig)' == 'true'">
    <PropertyGroup>
      <GstreamerZipAddress Condition="'$(Platform)' == 'x64'">https://github.com/lukeIam/VocaluxeDependencies/raw/master/zips/dependencies/gstreamer_x64.zip</GstreamerZipAddress>
      <GstreamerZipAddress Condition="'$(Platform)' == 'x86'">https://github.com/lukeIam/VocaluxeDependencies/raw/master/zips/dependencies/gstreamer_x86.zip</GstreamerZipAddress>
      <GstreamerTargetFolder Condition="'$(Platform)' == 'x64'">$(TargetDir)libs\unmanaged\gstreamer64\</GstreamerTargetFolder>
      <GstreamerTargetFolder Condition="'$(Platform)' == 'x86'">$(TargetDir)libs\unmanaged\gstreamer86\</GstreamerTargetFolder>
      <GstreamerGlobalPath Condition="'$(Platform)' == 'x64'">$(GSTREAMER_1_0_ROOT_X86_64)</GstreamerGlobalPath>
      <GstreamerGlobalPath Condition="'$(Platform)' == 'x86'">$(GSTREAMER_1_0_ROOT_X86)</GstreamerGlobalPath>
      <GstreamerDownload Condition="!Exists('$(GstreamerTargetFolder)') And ('$(GstreamerGlobalPath)' == '' Or !Exists('$(GstreamerGlobalPath)'))">true</GstreamerDownload>
      <GstreamerZipFolder>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)</GstreamerZipFolder>
    </PropertyGroup>
    <Message Text="gstreamer is missing - download started: $(GstreamerZipAddress)" Importance="normal" Condition="'$(GstreamerDownload)' == 'true'" />
    <DownloadFile SourceUrl="$(GstreamerZipAddress)" DestinationFolder="$(GstreamerZipFolder)" DestinationFileName="gstreamer_$(Platform).zip" Condition="'$(GstreamerDownload)' == 'true'" />
    <Unzip SourceFiles="$(GstreamerZipFolder)gstreamer_$(Platform).zip" DestinationFolder="$(GstreamerTargetFolder)" Condition="'$(GstreamerDownload)' == 'true'" />
  </Target>

  <Target Name="copyWebAppAfterBuild" AfterTargets="Build" Condition="'$(IsWindowsConfig)' == 'true'">
    <Message Text="copy the WebApp (built by VocaluxeWeb) to the Website folder" Importance="normal" />
    <ItemGroup>
      <WebAppFiles Include="$(ProjectDir)..\WebApp\dist\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)Website" />
    <Copy SourceFiles="@(WebAppFiles)" DestinationFiles="@(WebAppFiles->'$(TargetDir)Website\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="managedDepCopyAfterBuild" AfterTargets="Build">
    <Message Text="move all libs to the managed dependencies folder" Importance="normal" />
    <ItemGroup>
      <RootDLLFilesToMove Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(TargetFileName)" />
    </ItemGroup>
    <ItemGroup>
      <RootDLLCompanionFiles Include="@(RootDLLFilesToMove->'%(RootDir)%(Directory)%(Filename).pdb');@(RootDLLFilesToMove->'%(RootDir)%(Directory)%(Filename).xml');@(RootDLLFilesToMove->'%(FullPath).config')" />
      <OtherFilesToMove Include="@(RootDLLCompanionFiles)" Condition="Exists('%(FullPath)')" />
    </ItemGroup>
    <ItemGroup>
      <x64FolderFilesToMove Include="$(TargetDir)x64\*.*" />
    </ItemGroup>
    <ItemGroup>
      <x86FolderFilesToMove Include="$(TargetDir)x86\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(RootDLLFilesToMove)" DestinationFiles="@(RootDLLFilesToMove->'$(TargetDir)libs\managed\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(x64FolderFilesToMove)" DestinationFiles="@(x64FolderFilesToMove->'$(TargetDir)libs\managed\x64\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(x86FolderFilesToMove)" DestinationFiles="@(x86FolderFilesToMove->'$(TargetDir)libs\managed\x86\%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(OtherFilesToMove)" DestinationFiles="@(OtherFilesToMove->'$(TargetDir)libs\managed\%(Filename)%(Extension)')" />
    <Delete Files="@(RootDLLFilesToMove)" />
    <Delete Files="@(x64FolderFilesToMove)" />
    <Delete Files="@(x86FolderFilesToMove)" />
    <Delete Files="@(OtherFilesToMove)" />
    <RemoveDir Directories="$(TargetDir)\x64\;$(TargetDir)\x86\" />
  </Target>
</Project>
